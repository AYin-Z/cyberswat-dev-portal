# CyberSWAT 开发部子站 API 环境变量
# 复制为 .env 后按需修改（.env 不入库）

# JWT 签名密钥（生产必须替换为强随机值）
JWT_SECRET=dev-secret-change-me

# 内核监听端口（nginx 反代 8092 → 8093）
API_PORT=8093
# 容器内绑 0.0.0.0（nginx 反代）；本地开发可留空
API_HOST=0.0.0.0

# PostgreSQL（本地开发 5433；生产容器内用 compose 内网地址）
DATABASE_URL=postgresql://cyberswat:cyberswat@127.0.0.1:5433/cyberswat_dev?schema=public

# GitHub OAuth 二级认证（PRD 构思 #1 拍板：邮箱主 + GitHub 二级）
# 创建 OAuth App：https://github.com/settings/developers → New OAuth App
#   Application name: CyberSWAT 开发部子站
#   Homepage URL:     https://dev.cyberswat.cn
#   Callback URL:     https://dev.cyberswat.cn/api/auth/github/callback
# 创建后填入下面两个值
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 前端回跳地址（OAuth 回调后带 token 回前端）
FRONTEND_ORIGIN=http://localhost:5175
# 对外 API 根地址（OAuth 回调地址基准；生产 https://dev.cyberswat.cn）
PUBLIC_API_URL=http://127.0.0.1:8093
