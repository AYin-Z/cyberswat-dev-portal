// CyberSWAT 开发部子站 — 核心数据模型
// 命名空间规范：core_ 前缀 = 内核表；能力包表用各自 dbNamespace 前缀（如 announcement_）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 内核模型（core_） ============

model CoreUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nickname     String
  realName     String?
  teamInfo     String? // 区队/学号 — 公安院校隐私红线，仅内部
  grade        String? // 年级，如 "2026"
  skills       String[] @default([])
  bio          String?
  avatarUrl    String?
  github       String? // GitHub 用户名（OAuth 绑定后同步）
  links        Json     @default("[]") // [{label, url}] 外链区
  role         CoreRole @default(MEMBER)
  active       Boolean  @default(true)
  allowMatch   Boolean  @default(true) // 接收项目匹配邀请开关（P2）
  // GitHub OAuth 绑定
  githubId     String?  @unique
  githubToken  String? // OAuth access token（加密存储，M1+）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  announcements   Announcement[] @relation("AnnouncementAuthor")
  announcementReads AnnouncementRead[]
  ideas           Idea[]         @relation("IdeaAuthor")
  ideaJoins       IdeaJoiner[]
  projects        Project[]      @relation("ProjectLead")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  posts           Post[]         @relation("PostAuthor")
  postComments    PostComment[]
  postLikes       PostLike[]
  notifications   Notification[]
  mentions        NotificationMention[]

  @@map("core_users")
}

enum CoreRole {
  GUEST
  MEMBER
  DEPT_LEADER
  ADMIN
}

/// 角色 → 权限点映射（L1 落库后管理员可调整；L0 在内存按 defaultRoles 计算）
model CoreRolePermission {
  id         String @id @default(uuid())
  role       CoreRole
  permission String // 权限点 id，如 idea.promote
  grantedBy  String? // 管理员 id（审计）
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("core_role_permissions")
}

/// 工具调用审计 — 公安院校审计铁律
model CoreToolCall {
  id         String   @id @default(uuid())
  toolId     String
  caller     String // 用户 id 或 bot:<agent-id>
  agentId    String?
  params     Json
  result     Json?
  status     String   @default("ok") // ok | error | pending | rejected
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([toolId, createdAt])
  @@map("core_tool_calls")
}

/// 插件状态（L1 配置驱动启停用；L0 编译期注册，无行）
model CorePlugin {
  id        String   @id
  version   String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())

  @@map("core_plugins")
}

/// 邀请令牌 — 成员生命周期入口（部长开邀请，候选人凭链接注册）
/// 令牌只存哈希：即使 DB 泄露也不能伪造邀请
model CoreInvite {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      CoreRole  @default(MEMBER) // 邀请授予的角色
  expiresAt DateTime
  maxUses   Int       @default(1) // 可限定名额（招新批量化）
  usedCount Int       @default(0)
  createdBy String // 创建者 id（审计）
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("core_invites")
}

/// refresh token 轮换 — 签发时落库，轮换时旧 token 标记 revoked（防重放）
model CoreRefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  replacedBy String? // 轮换后的新 token id（审计链）
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("core_refresh_tokens")
}

// ============ 公告能力包（announcement_，dbNamespace: announcement） ============

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  important   Boolean  @default(false) // 重要公告需"确认收到"
  publishedAt DateTime?
  authorId    String
  author      CoreUser  @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads       AnnouncementRead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@map("announcement_announcements")
}

/// 已读追踪 — 部长视角核心：谁看了没看、重要公告是否确认
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           CoreUser     @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())
  confirmed      Boolean      @default(false) // 重要公告"确认收到"

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ============ 点子墙能力包（idea_wall_，dbNamespace: idea_wall） ============

enum IdeaStatus {
  RECRUITING // 招募中（等成员加入）
  INCUBATING // 孵化中（有人加入，讨论推进）
  PROMOTED   // 已转正为正式项目（M3 关联项目表）
  ARCHIVED   // 已废弃
}

/// 点子墙 — 有想法但缺人力/技术/资源 → 发布点子招募成员（PRD 构思 #4）
model Idea {
  id          String     @id @default(uuid())
  title       String
  description String // 痛点/想法/预想方案
  need        String // 缺什么：人力/技术力/资源（自由文本，如 "缺 1 个会 Vue 的前端"）
  techStack   String[]   @default([]) // 技术栈标签
  status      IdeaStatus @default(RECRUITING)
  authorId    String
  author      CoreUser   @relation("IdeaAuthor", fields: [authorId], references: [id])
  joiners     IdeaJoiner[]
  promotedProjectId String? // 转正后的项目 id（M3 建项目表后关联）
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("idea_wall_ideas")
}

/// 认领/加入 — "点子→人力"连接机制：成员申请加入，发起人看到人力需求被响应
model IdeaJoiner {
  id        String   @id @default(uuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      CoreUser @relation(fields: [userId], references: [id])
  message   String? // 加入留言（我能做什么/我的技能）
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
  @@map("idea_wall_joiners")
}

// ============ 项目能力包（project_，dbNamespace: project） ============

enum ProjectStatus {
  ACTIVE   // 进行中
  PAUSED   // 暂停
  DONE     // 已完成
  ARCHIVED // 已归档
}

enum TaskStatus {
  TODO      // 待接单
  IN_PROGRESS // 进行中
  REVIEW    // 待验收
  DONE      // 已完成
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// 项目 — 点子转正后的正式形态（OSPP 卡片模板：名称/描述/难度/技术栈/负责人/状态）
model Project {
  id          String        @id @default(uuid())
  name        String
  description String
  difficulty  String? // 难度分级：入门/进阶/挑战
  techStack   String[]      @default([])
  status      ProjectStatus @default(ACTIVE)
  // 人力需求（转正时从点子带过来）
  needPeople  String?
  leadId      String // 项目负责人（部长指派或点子发起人）
  lead        CoreUser      @relation("ProjectLead", fields: [leadId], references: [id])
  // 从点子转正而来（可选）
  ideaId      String?       @unique
  members     ProjectMember[]
  tasks       Task[]
  repoUrl     String? // 成果仓库
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("project_projects")
}

/// 项目成员（认领/加入项目）
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      CoreUser @relation(fields: [userId], references: [id])
  role      String   @default("MEMBER") // LEAD / MEMBER
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

/// 任务 — 指派→接单→提交→验收闭环（信息流转三件套之"任务执行"）
model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime? // 截止时间
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String? // 被指派人
  assignee    CoreUser?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String // 创建者（部长/负责人）
  creator     CoreUser     @relation("TaskCreator", fields: [creatorId], references: [id])
  submitNote  String? // 提交说明（验收信息）
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, assigneeId])
  @@index([projectId])
  @@map("project_tasks")
}

// ============ 社区能力包（community_，dbNamespace: community） ============

enum PostBoard {
  GENERAL // 灌水
  HELP    // 求助
  SHARE   // 分享
  RECRUIT // 招人
}

/// 帖子 — 轻量社区（PRD 构思 #6：帖子+评论+点赞+@通知）
model Post {
  id        String    @id @default(uuid())
  board     PostBoard @default(GENERAL)
  title     String
  content   String
  authorId  String
  author    CoreUser  @relation("PostAuthor", fields: [authorId], references: [id])
  comments  PostComment[]
  likes     PostLike[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([board, createdAt])
  @@map("community_posts")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    CoreUser @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@map("community_comments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      CoreUser @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("community_likes")
}

/// 通知中心 — @提及/任务/公告/点子 全量站内通知
model Notification {
  id        String    @id @default(uuid())
  userId    String // 接收者
  user      CoreUser  @relation(fields: [userId], references: [id])
  type      String // mention / task / announcement / idea / system
  title     String
  content   String?
  link      String? // 前端路由，如 /posts/xxx
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, read, createdAt])
  @@map("core_notifications")
}

/// @提及记录 — 帖子/评论中的 @昵称 解析结果
model NotificationMention {
  id        String   @id @default(uuid())
  postId    String?
  commentId String?
  mentionedUserId String
  mentionedUser   CoreUser @relation(fields: [mentionedUserId], references: [id])
  byUserId  String
  createdAt DateTime @default(now())

  @@index([mentionedUserId, createdAt])
  @@map("core_mentions")
}

// ============ 技能词表（P1：两级 分类→技术） ============

/// 技能分类（Web前端/后端/数据库/安全/算法/AI/运维/测试/产品/设计）
model CoreSkillCategory {
  id        String      @id @default(uuid())
  name      String      @unique
  sortOrder Int         @default(0)
  skills    CoreSkill[]
  createdAt DateTime    @default(now())

  @@map("core_skill_categories")
}

/// 技能（技术级，name 唯一；用户 skills 数组存规范化 name）
model CoreSkill {
  id         String             @id @default(uuid())
  name       String             @unique
  categoryId String
  category   CoreSkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([categoryId])
  @@map("core_skills")
}

/// 内容举报（P5：帖子/评论/点子/公告 → 部长处置队列）
model CoreReport {
  id        String   @id @default(uuid())
  targetType String // post / comment / idea / announcement
  targetId  String
  reason    String // 举报原因（简短）
  reporterId String // 举报人
  status    String   @default("PENDING") // PENDING / RESOLVED / DISMISSED
  resolvedBy String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("core_reports")
}

// ============ Agent 体系（R2） ============

/// Agent 配置（内置 bot 首行数据；部门 bot 同表扩展）
model CoreAgent {
  id        String   @id @default(uuid())
  name      String   @unique // dev-assistant / attack-assistant ...
  displayName String // 展示名：开发部助理
  persona   String // 人格提示词
  identity  String   @unique // bot:<name> 对应 core_users 身份
  userId    String? // 关联的 bot 用户 id（core_users）
  tools     String[] @default([]) // 工具白名单覆盖（空=继承默认可见集）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("core_agents")
}

// ============ OAuth 2.1（R2-B MCP 接入） ============

/// DCR 注册的 OAuth 客户端（成员 agent）
model CoreOauthClient {
  id           String   @id // client_id
  secretHash   String? // client_secret_hash（PKCE 流程可为空）
  redirectUris String[] @default([])
  grantTypes   String[] @default([])
  responseTypes String[] @default([])
  scope        String   @default("") // 注册时声明的默认 scope
  clientName   String?
  issuedAt     DateTime @default(now())
  secretExpiresAt DateTime?
  createdBy    String? // 发起注册的成员（DCR 无认证时为 null）

  @@map("core_oauth_clients")
}

/// 授权码（一次性）
model CoreOauthCode {
  id          String   @id @default(uuid())
  clientId    String
  code        String   @unique
  codeChallenge String // PKCE S256
  userId      String
  scopes      String[] @default([])
  redirectUri String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("core_oauth_codes")
}

/// OAuth access/refresh token（签发/轮换/撤销）
model CoreOauthToken {
  id         String   @id @default(uuid())
  clientId   String
  userId     String
  scope      String[] @default([])
  tokenHash  String   @unique // refresh token 哈希
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("core_oauth_tokens")
}
