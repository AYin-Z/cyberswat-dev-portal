// CyberSWAT 开发部子站 — 核心数据模型
// 命名空间规范：core_ 前缀 = 内核表；能力包表用各自 dbNamespace 前缀（如 announcement_）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 内核模型（core_） ============

model CoreUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nickname     String
  realName     String?
  teamInfo     String? // 区队/学号 — 公安院校隐私红线，仅内部
  grade        String? // 年级，如 "2026"
  skills       String[] @default([])
  bio          String?
  avatarUrl    String?
  github       String? // GitHub 用户名（OAuth 绑定后同步）
  links        Json     @default("[]") // [{label, url}] 外链区
  role         CoreRole @default(MEMBER)
  active       Boolean  @default(true)
  // GitHub OAuth 绑定
  githubId     String?  @unique
  githubToken  String? // OAuth access token（加密存储，M1+）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  announcements   Announcement[] @relation("AnnouncementAuthor")
  announcementReads AnnouncementRead[]

  @@map("core_users")
}

enum CoreRole {
  GUEST
  MEMBER
  DEPT_LEADER
  ADMIN
}

/// 角色 → 权限点映射（L1 落库后管理员可调整；L0 在内存按 defaultRoles 计算）
model CoreRolePermission {
  id         String @id @default(uuid())
  role       CoreRole
  permission String // 权限点 id，如 idea.promote
  grantedBy  String? // 管理员 id（审计）
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("core_role_permissions")
}

/// 工具调用审计 — 公安院校审计铁律
model CoreToolCall {
  id         String   @id @default(uuid())
  toolId     String
  caller     String // 用户 id 或 bot:<agent-id>
  agentId    String?
  params     Json
  result     Json?
  status     String   @default("ok") // ok | error | pending | rejected
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([toolId, createdAt])
  @@map("core_tool_calls")
}

/// 插件状态（L1 配置驱动启停用；L0 编译期注册，无行）
model CorePlugin {
  id        String   @id
  version   String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())

  @@map("core_plugins")
}

/// 邀请令牌 — 成员生命周期入口（部长开邀请，候选人凭链接注册）
/// 令牌只存哈希：即使 DB 泄露也不能伪造邀请
model CoreInvite {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      CoreRole  @default(MEMBER) // 邀请授予的角色
  expiresAt DateTime
  maxUses   Int       @default(1) // 可限定名额（招新批量化）
  usedCount Int       @default(0)
  createdBy String // 创建者 id（审计）
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("core_invites")
}

/// refresh token 轮换 — 签发时落库，轮换时旧 token 标记 revoked（防重放）
model CoreRefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  replacedBy String? // 轮换后的新 token id（审计链）
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("core_refresh_tokens")
}

// ============ 公告能力包（announcement_，dbNamespace: announcement） ============

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  important   Boolean  @default(false) // 重要公告需"确认收到"
  publishedAt DateTime?
  authorId    String
  author      CoreUser  @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads       AnnouncementRead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@map("announcement_announcements")
}

/// 已读追踪 — 部长视角核心：谁看了没看、重要公告是否确认
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           CoreUser     @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())
  confirmed      Boolean      @default(false) // 重要公告"确认收到"

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}
